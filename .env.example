# Copy to .env for local use. Never commit a filled .env.
# Optional OpenAI-compatible gateway (for example a local 9Router instance).
RAG_GATEWAY_BASE_URL=
RAG_GATEWAY_MODEL=
RAG_GATEWAY_FALLBACK_MODEL=
RAG_GATEWAY_FALLBACK_BASE_URL=
# Read at call time; leave empty when the gateway handles provider connections itself.
RAG_GATEWAY_API_KEY=
# Path to a JSON price table, see config/prices.example.json.
RAG_PRICE_TABLE=
# Optional Langfuse export (self-hosted or cloud). Keys are read at export time.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Unpacked education release for the compose "education" profile.
EDUCATION_RELEASE_DIR=
EDUCATION_RELEASE=v1
